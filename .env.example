# Copy to .env and fill in. Only OPENAI_API_KEY is required; Notion and Sheets are optional.

# --- LLM -------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...
LLM_MODEL=gpt-6-luna
# none | low | medium | high
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=60
# Processing pauses for the day once this much was spent on LLM calls (0 = no cap).
LLM_DAILY_BUDGET_USD=1.00

# --- Agent -----------------------------------------------------------------------
# review: tasks and drafts wait for approval in the UI. auto: everything runs at once.
AGENT_MODE=review
AGENT_POLL_SECONDS=60
AGENT_MAX_ATTEMPTS=8
AGENT_CONCURRENCY=3
AGENT_LOOKBACK_DAYS=7
# Remove UNREAD after processing (off: the agent never hides unread mail from you).
AGENT_MARK_AS_READ=false
AGENT_DB_PATH=data/agent.sqlite3
# Who owns the mailbox; helps the model judge priority and write replies.
AGENT_OWNER_CONTEXT=Freelance AI engineer. Leads and client requests matter most.
# Language for summaries and tasks. Replies always use the sender's language.
AGENT_WORKING_LANGUAGE=English

# --- Google (Gmail, Sheets) ------------------------------------------------------
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GMAIL_PROCESSED_LABEL=Agent/Processed
# Optional: log every processed email to a sheet (columns A:J, header is created).
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Sheet1!A:J

# --- Notion (optional) -----------------------------------------------------------
NOTION_API_KEY=
NOTION_DATABASE_ID=
# Only needed when the database has several data sources.
NOTION_DATA_SOURCE_ID=
NOTION_TITLE_PROPERTY=Name
# A Select property; leave the name as is if your database has one.
NOTION_PRIORITY_PROPERTY=Priority
# A Text property used to find a page again after a crash (prevents duplicates).
NOTION_EMAIL_ID_PROPERTY=Gmail ID

# --- API server (gmail-agent serve | demo) ---------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# `serve` exposes your mailbox without a login, so it refuses non-local addresses.
# Set to true only behind your own authentication (a VPN, an auth proxy).
API_ALLOW_REMOTE=false
# Proxies allowed to set X-Forwarded-For (the demo's quotas are per client address).
API_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Public demo (gmail-agent demo) ----------------------------------------------
# No Google account needed. Without OPENAI_API_KEY only the recorded presets work.
DEMO_DB_PATH=data/demo.sqlite3
# Salt for hashing visitor addresses (any long random string); quotas survive restarts.
DEMO_SECRET=
DEMO_DAILY_QUOTA=5
# Live LLM spend cap per calendar month; past it, only the presets work.
DEMO_MONTHLY_BUDGET_USD=5.00
DEMO_SANDBOX_TTL_HOURS=24
DEMO_MAX_SANDBOXES=500

# --- Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
