            "title": "Task Title"
          },
          "task_description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Description"
          },
          "skip": {
            "items": {
              "$ref": "#/components/schemas/ActionKind"
            },
            "type": "array",
            "maxItems": 4,
            "title": "Skip"
          }
        },
        "type": "object",
        "title": "ApproveIn",
        "description": "Edits made in review. Empty fields keep the model's text."
      },
      "BlockedOut": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Until"
          }
        },
        "type": "object",
        "required": [
          "service",
          "reason",
          "until"
        ],
        "title": "BlockedOut"
      },
      "Category": {
        "type": "string",
        "enum": [
          "lead",
          "client",
          "invoice",
          "meeting",
          "support",
          "newsletter",
          "notification",
          "personal",
          "spam",
          "other"
